// fn.math_ext_angle_vector2degXZ(vector1) => degrees 根据向量计算旋转角度

// +x为右，-x为左，+y为上，-y为下，-z为前，+z为后

t.vector_diff = args[0];

// xy轴旋转
t.v_xz = fn.math_ext_vector_2(t.vector_diff.x, t.vector_diff.z);
t.len_xz = fn.math_ext_vector_2_len(t.v_xz); //计算xz平面投影线长度

t.y_rad = (t.len_xz > 0.0000039) // 去噪声
    ? -math.atan2(t.vector_diff.x, -t.vector_diff.z)
    : 0;

t.v_y_xz = fn.math_ext_vector_2(t.vector_diff.y, t.len_xz);
t.len_y_xz = fn.math_ext_vector_2_len(t.v_y_xz); //计算y_xz平面投影线长度

t.x_rad = (t.len_y_xz > 0.00000763) // 去噪声
    ? -math.atan2(t.vector_diff.y, t.len_xz)
    : math.pi/2;

t.z_rad = 0;

// 弧度转角度
t.x_deg = fn.math_ext_angle_cvt_rad2deg(t.x_rad);
t.y_deg = fn.math_ext_angle_cvt_rad2deg(t.y_rad);
t.z_deg = fn.math_ext_angle_cvt_rad2deg(t.z_rad);

t.angle_deg = fn.math_ext_vector_3(
    t.x_deg-90,
    t.y_deg,
    t.z_deg
);

return t.angle_deg;
